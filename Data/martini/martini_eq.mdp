; Martini 3: equilibration of a bilayer in the xy plane
; semi-isotropic pressure coupling: the area (x,y) and the thickness (z) of the box change independently,
; at the same pressure, so that the membrane is at zero surface tension
; the time step is shorter than in the production run because the starting structure can be far from equilibrium
integrator               = md
dt                       = 0.01         ; 10 fs
nsteps                   = 100000       ; 1 ns
nstxout-compressed       = 5000
compressed-x-precision   = 100
nstenergy                = 500
nstlog                   = 10000
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1           ; fixed pair-list buffer, as recommended for Martini 3
pbc                      = xyz
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw-type                 = cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
nsttcouple               = 20
nstpcouple               = 10
comm-mode                = Linear
nstcomm                  = 100
constraints              = none
ref_t                    = 323
pcoupl                   = c-rescale
pcoupltype               = semiisotropic
tau_p                    = 12.0
compressibility          = 3e-4 3e-4
ref_p                    = 1.0 1.0
gen_vel                  = yes
gen_temp                 = 323
gen_seed                 = -1
