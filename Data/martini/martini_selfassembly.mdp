; Martini 3: self-assembly from a random mixture of lipids and water
; the box is coupled isotropically: it can change size but not shape
integrator               = md
dt                       = 0.02         ; 20 fs
nsteps                   = 1500000      ; 30 ns
nstxout-compressed       = 2500         ; a frame every 50 ps
compressed-x-precision   = 100
nstenergy                = 500
nstlog                   = 50000
cutoff-scheme            = Verlet
nstlist                  = 20
rlist                    = 1.35
verlet-buffer-tolerance  = -1           ; fixed pair-list buffer, as recommended for Martini 3
pbc                      = xyz
coulombtype              = reaction-field
rcoulomb                 = 1.1
epsilon_r                = 15
epsilon_rf               = 0
vdw-type                 = cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.1
tcoupl                   = v-rescale
tc-grps                  = System
tau_t                    = 1.0
nsttcouple               = 20
nstpcouple               = 10
comm-mode                = Linear
nstcomm                  = 100
constraints              = none
ref_t                    = 323
pcoupl                   = c-rescale
pcoupltype               = isotropic
tau_p                    = 12.0
compressibility          = 3e-4
ref_p                    = 1.0
gen_vel                  = yes
gen_temp                 = 323
gen_seed                 = -1
